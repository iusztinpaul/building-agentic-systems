# User Identifier
TREE_USER_IDENTIFIER=default.user@example.com

# MongoDB (infra endpoints + credentials)
# MONGO_SCHEME: "mongodb" (local replica set, default) or "mongodb+srv"
# (Atlas cluster — TLS implied, MONGO_PORT ignored).
MONGO_SCHEME=mongodb
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=tree
MONGO_INITDB_ROOT_PASSWORD=tree
MONGO_INITDB_DATABASE=tree

MONGOT_PORT=27028

# MongoDB MCP server + Atlas IaC (Atlas Admin API service account). Loaded into
# the agent environment via direnv (.envrc -> dotenv); also consumed by the
# cluster IaC at `apps/memory/deploy/atlas_cluster.py` (make memory-atlas-*).
MDB_MCP_API_CLIENT_ID=your-atlas-service-account-client-id
MDB_MCP_API_CLIENT_SECRET=your-atlas-service-account-client-secret
# Optional: comma-separated CIDRs the Atlas IaC adds to the project IP access
# list on `atlas-up` (e.g. "203.0.113.4/32,198.51.100.0/24"). Empty = no change.
ATLAS_ACCESS_CIDRS=

# Voyage AI API
VOYAGE_API_KEY=your-voyage-api-key

# Prefect (infra endpoint)
PREFECT_PORT=4200
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_ACCOUNT_ID=required-only-in-prod
PREFECT_WORKSPACE_ID=required-only-in-prod
PREFECT_API_KEY=required-only-in-prod
# Prod only: the Cloud workspace URL the prefect-worker container points at
# (mirror PREFECT_API_URL). Local leaves this unset — the worker defaults to
# the in-compose prefect-server.
PREFECT_API_URL_WORKER=required-only-in-prod

# Prefect Horizon (FastMCP Cloud) — managed hosting for the tree-memory MCP
# server. TREE_MEMORY_CLOUD_URL is the deployed endpoint. The server is
# protected by Horizon Authentication (OAuth + org membership), so clients
# authenticate via the browser OAuth flow — there is NO static client token.
# PREFECT_HORIZON_API_KEY is the Horizon platform/account key (deploy + CLI
# management), not a client connection credential.
TREE_MEMORY_CLOUD_URL=https://tree-memory.fastmcp.app/mcp
PREFECT_HORIZON_API_KEY=required-only-in-prod
# Set true on the Horizon deployment so the MCP lifespan skips index bootstrap
# (Atlas vector-index create + mongot sync poll) that would blow the 60s
# serverless readiness window. Indexes are built by the indexing pipeline.
MCP_SKIP_INDEX_BOOTSTRAP=false

# LLM API
GOOGLE_API_KEY=your-google-api-key

# Modal (vLLM-hosted embedding fallback)
MODAL_EMBEDDING_API_KEY=your-modal-embedding-api-key

# Bright Data (web scraping)
BRIGHTDATA_API_KEY=your-brightdata-api-key
BRIGHTDATA_UNLOCKER_ZONE=your-brightdata-unlocker-zone
BRIGHTDATA_SERP_ZONE=your-brightdata-serp-zone

# Opik observability (monitoring only). With no OPIK_API_KEY the whole layer
# no-ops cleanly. OPIK_WORKSPACE / OPIK_PROJECT_NAME are optional.
OPIK_API_KEY=<your-opik-api-key>
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=tree-memory

# Optional: override the YAML path (defaults to apps/memory/configs/default.yaml).
# APP_CONFIG_PATH=apps/memory/configs/default.yaml
