# User Identifier
TREE_USER_IDENTIFIER=default.user@example.com

# MongoDB (infra endpoints + credentials)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=tree
MONGO_INITDB_ROOT_PASSWORD=tree
MONGO_INITDB_DATABASE=tree
MONGOT_PORT=27028

# MongoDB MCP server (Atlas Admin API service account). Loaded into the agent
# environment via direnv (.envrc -> dotenv), not by the memory app itself.
MDB_MCP_API_CLIENT_ID=your-atlas-service-account-client-id
MDB_MCP_API_CLIENT_SECRET=your-atlas-service-account-client-secret

# Voyage AI API
VOYAGE_API_KEY=your-voyage-api-key

# Prefect (infra endpoint)
PREFECT_PORT=4200
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_ACCOUNT_ID=required-only-in-prod
PREFECT_WORKSPACE_ID=required-only-in-prod

# LLM API
GOOGLE_API_KEY=your-google-api-key

# Modal (vLLM-hosted embedding fallback)
MODAL_EMBEDDING_API_KEY=your-modal-embedding-api-key

# Bright Data (web scraping)
BRIGHTDATA_API_KEY=your-brightdata-api-key
BRIGHTDATA_UNLOCKER_ZONE=your-brightdata-unlocker-zone
BRIGHTDATA_SERP_ZONE=your-brightdata-serp-zone

# Opik observability (monitoring only). With no OPIK_API_KEY the whole layer
# no-ops cleanly. OPIK_WORKSPACE / OPIK_PROJECT_NAME are optional.
OPIK_API_KEY=<your-opik-api-key>
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=tree-memory

# Optional: override the YAML path (defaults to apps/memory/configs/default.yaml).
# APP_CONFIG_PATH=apps/memory/configs/default.yaml
