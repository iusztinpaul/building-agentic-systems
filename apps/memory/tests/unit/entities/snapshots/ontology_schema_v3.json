      "description": "Umbrella edge for the 14 POLE+O domain relations (+ Tree extensions). Discriminated by ``semantic_type``.",
      "semantic_types": {
        "alias_of": {
          "allowed_pairs": [
            [
              "event",
              "event"
            ],
            [
              "location",
              "location"
            ],
            [
              "object",
              "object"
            ],
            [
              "organization",
              "organization"
            ],
            [
              "person",
              "person"
            ]
          ],
          "description": "Surface form is an alias for the target. Distinct from structural ``same_as`` (which is the dedup-confirmed merge edge) \u2014 ``alias_of`` is LLM-extractable narrative."
        },
        "employed_by": {
          "allowed_pairs": [
            [
              "person",
              "organization"
            ]
          ],
          "description": "Person is employed by an organization. Carries role + date range; the canonical Tree subtype for the resulting period is event/employment.",
          "properties": {
            "end_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "End of the relationship in ISO 8601 (YYYY-MM-DD), or None when the relationship is ongoing or the end is unknown.",
              "title": "End Date"
            },
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Role or title held during the relationship (e.g. 'senior engineer', 'board member').",
              "title": "Role"
            },
            "start_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Start of the relationship in ISO 8601 (YYYY-MM-DD), or None when the start is unknown / open-ended.",
              "title": "Start Date"
            }
          },
          "required": []
        },
        "experienced_by": {
          "allowed_pairs": [
            [
              "person",
              "event"
            ]
          ],
          "description": "Tree extension: a person experienced an event (commonly an event with subtype ``episode``). Re-routes the legacy ``EdgeType.EXPERIENCED`` semantics.",
          "properties": {
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Role the person played in the event (e.g. 'protagonist', 'witness'). None when unspecified.",
              "title": "Role"
            }
          },
          "required": []
        },
        "has_task": {
          "allowed_pairs": [
            [
              "person",
              "object"
            ]
          ],
          "description": "Tree extension: a person has a task (object with subtype ``task``). Re-routes the legacy ``EdgeType.TODO`` semantics into the POLE+O umbrella so the LLM emits a single ``related_to`` edge type.",
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Lifecycle status of the task \u2014 e.g. 'pending', 'in_progress', 'done', 'cancelled'. None means unspecified.",
              "title": "Status"
            }
          },
          "required": []
        },
        "headquarters_at": {
          "allowed_pairs": [
            [
              "organization",
              "location"
            ]
          ],
          "description": "An organization's headquarters is at a location."
        },
