{
  "name": "tree-agent",
  "version": "0.1.0",
  "description": "tree-agent — a light pi clone: the coding-agent harness of Tree: Your Rooted Personal Assistant.",
  "private": true,
  "type": "module",
  "bin": {
    "tree-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/cli.ts",
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "lint": "biome check src tests"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.34.8+sha256.5be9fac9764583af5fa07015b9b0aa930ef634535df9fa6f464020d72b195630",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.4.0",
    "quickjs-emscripten": "0.32.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
