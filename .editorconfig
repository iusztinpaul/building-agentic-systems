root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml,md,toml}]
indent_size = 2

[{Makefile,**/Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
